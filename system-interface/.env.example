# Configuração do Sistema de Voz - TalkingBuddy
# Copie este arquivo para .env e ajuste conforme necessário

# Modelo Ollama (exemplos: gemma3:1b, gemma3-ptbr, smollm2:135m)
OLLAMA_MODEL=gemma3:1b
OLLAMA_URL=http://localhost:11434/api/chat

# Piper TTS (ajuste paths conforme sua instalação)
PIPER_BINARY=~/piper/piper/piper
PIPER_MODEL=pt_BR-faber-medium.onnx
PIPER_MODEL_PATH=~/piper/piper/

# Dispositivos de áudio ALSA
# Execute test_audio_devices.py para identificar seus dispositivos
# Saída de áudio (adaptador P2 USB - Card 3)
AUDIO_DEVICE=plughw:3,0

# Entrada de áudio (microfone USB - Card 2)
MICROPHONE_DEVICE=plughw:2,0

# Whisper STT (reconhecimento de voz)
WHISPER_ENABLED=true
WHISPER_MODEL=ggml-base.bin
WHISPER_BINARY=/home/pi/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/home/pi/whisper.cpp/models

# ===== TTS ENGINE =====
# Engine: 'piper' (default, offline) ou 'supertonic' (multilingual, faster)
TTS_ENGINE=piper
SUPERTONIC_LANGUAGE=pt
SUPERTONIC_PERSONALITY=neutral

# ===== WAKE WORD DETECTION =====
# Modo: 'local' (Vosk no Raspberry, recomendado), 'esp32' (hardware externo), 'disabled'
WAKE_WORD_MODE=local

# Palavra de ativação
WAKE_WORD_KEYWORD=marvin

# Configurações Locais (Vosk) - apenas para WAKE_WORD_MODE=local
VOSK_MODEL_PATH=~/vosk-models/vosk-model-small-pt-0.3
WAKE_WORD_SAMPLE_RATE=48000

# Tempo mínimo entre wake words (segundos) - evita duplicatas
WAKE_WORD_DEBOUNCE_TIME=2.0

# Configurações ESP32 - apenas para WAKE_WORD_MODE=esp32
ESP32_BAUD_RATE=115200
ESP32_RECONNECT_INTERVAL=5


